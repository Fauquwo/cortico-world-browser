{
  // 只有 Node 侧代码,lib 里不放 DOM。本包没有自定义面板,所以不需要第二份配置。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // 开发期把 `cortico/*` 指到框架 checkout;装进宿主运行时不靠它,
    // 那时由框架 `src/extensions/runtime.ts` 的模块钩子解析。这个包住在 Cortina 工作区的
    // state/packages/ 下,框架 clone 在 state/cortico/,所以是往回两级。
    "paths": {
      "cortico/*": ["../../cortico/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
